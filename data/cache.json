    "Yuusha no Rokkotsu de": {
      "aliases": [
        {
          "text": "Megami \"Isekai Tensei Nani ni Naritai Desu ka\" Ore \"Yuusha no Rokkotsu de\"",
          "lang": "romaji"
        },
        {
          "text": "My Ribdiculous Reincarnation",
          "lang": "english"
        },
        {
          "text": "\u5973\u795e\u300c\u7570\u4e16\u754c\u8ee2\u751f\u4f55\u306b\u306a\u308a\u305f\u3044\u3067\u3059\u304b\u300d \u4ffa\u300c\u52c7\u8005\u306e\u808b\u9aa8\u3067\u300d",
          "lang": "native"
        },
        {
          "text": "Goddess: \"What Do You Want to Turn Into When You're Reincarnated in Another World?\" Me: \"Into a Hero's Rib\"",
          "lang": "synonym"
        },
        {
          "text": "\u52c7\u8005\u306e\u808b\u9aa8",
          "lang": "synonym"
        },
        {
          "text": "Yuusha no Rokkotsu",
          "lang": "synonym"
        },
        {
          "text": "Reinkarnasiku... Ingin Jadi Tulang Rusuk Pahlawan!",
          "lang": "synonym"
        },
        {
          "text": "\u0e17\u0e48\u0e32\u0e19\u0e40\u0e17\u0e1e\u0e18\u0e34\u0e14\u0e32\u0e08\u0e31\u0e14\u0e21\u0e32 \u0e1c\u0e21\u0e01\u0e47\u0e08\u0e31\u0e14\u0e44\u0e1b \u0e02\u0e2d\u0e40\u0e01\u0e34\u0e14\u0e43\u0e2b\u0e21\u0e48\u0e40\u0e1b\u0e47\u0e19\u0e0b\u0e35\u0e48\u0e42\u0e04\u0e23\u0e07\u0e1c\u0e39\u0e49\u0e01\u0e25\u0e49\u0e32\u0e25\u0e30\u0e01\u0e31\u0e19\u0e04\u0e23\u0e31\u0e1a",
          "lang": "synonym"
        }
      ],
