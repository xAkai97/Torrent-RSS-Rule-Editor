          "text": "\u0414\u0430\u0436\u0435 \u043a\u043e\u043f\u0438\u044f \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u0430 \u0432\u043b\u044e\u0431\u0438\u0442\u044c\u0441\u044f",
          "lang": "synonym"
        },
        {
          "text": "\u0e23\u0e31\u0e01\u0e09\u0e31\u0e19\u0e40\u0e17\u0e35\u0e22\u0e21\u0e40\u0e18\u0e2d",
          "lang": "synonym"
        }
      ],
